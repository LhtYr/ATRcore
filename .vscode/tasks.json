{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Make: debug",
            "type": "process",
            "command": "C:/msys64/usr/bin/make.exe",
            "args": ["debug"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {"PATH": "C:\\msys64\\clang64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"}
            },
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Make: check",
            "type": "process",
            "command": "C:/msys64/usr/bin/make.exe",
            "args": ["check"],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {"PATH": "C:\\msys64\\clang64\\bin;C:\\msys64\\usr\\bin;${env:PATH}"}
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
