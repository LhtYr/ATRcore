clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O3 -march=native  -c src/main.c -o build/src/main.o
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O3 -march=native  -c src/param_file.c -o build/src/param_file.o
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O3 -march=native  -c model/solver/BoundaryProfile.c -o build/model/solver/BoundaryProfile.o
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O3 -march=native  -c model/solver/BoundaryDefaults.c -o build/model/solver/BoundaryDefaults.o
clang  build/src/main.o build/src/param_file.o build/model/solver/BoundaryProfile.o build/model/solver/BoundaryDefaults.o -o build/main.exe -lm
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O3 -march=native  -c tools/char_main.c -o build/tools/tools/char_main.o
clang  build/tools/tools/char_main.o build/src/param_file.o build/model/solver/BoundaryProfile.o build/model/solver/BoundaryDefaults.o -o build/char.exe -lm
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O0 -g3  -c src/main.c -o build/debug/src/main.o
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O0 -g3  -c src/param_file.c -o build/debug/src/param_file.o
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O0 -g3  -c model/solver/BoundaryProfile.c -o build/debug/model/solver/BoundaryProfile.o
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O0 -g3  -c model/solver/BoundaryDefaults.c -o build/debug/model/solver/BoundaryDefaults.o
clang  build/debug/src/main.o build/debug/src/param_file.o build/debug/model/solver/BoundaryProfile.o build/debug/model/solver/BoundaryDefaults.o -o build/main_debug.exe -lm
clang -Iinclude -std=c11 -Wall -Wextra -Wshadow -MMD -MP -O0 -g3  -c tools/char_main.c -o build/debug/tools/char_main.o
clang  build/debug/tools/char_main.o build/debug/src/param_file.o build/debug/model/solver/BoundaryProfile.o build/debug/model/solver/BoundaryDefaults.o -o build/char_debug.exe -lm
